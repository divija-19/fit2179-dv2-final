{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "transparent", "tickColor": "transparent",
      "labelColor": "#d0cac0", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 14, "titleFontSize": 11
    },
    "legend": {
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    }
  },
  "data": { "url": "data/genre_by_state.json" },
  "layer": [
    {
      "mark": { "type": "rect" },
      "encoding": {
        "x": {
          "field": "state", "type": "nominal",
          "axis": { "title": null, "labelFontSize": 14, "labelAngle": 0 },
          "sort": ["NSW","QLD","SA","TAS","VIC","WA"]
        },
        "y": {
          "field": "genre", "type": "nominal",
          "sort": ["Electronic","Rock","Country","Indie","Other"],
          "axis": { "title": null, "labelFontSize": 14 }
        },
        "color": {
          "field": "pct", "type": "quantitative",
          "scale": { "scheme": "purpleorange", "domainMid": 20, "domain": [10, 32] },
          "legend": { "title": "Share (%)", "gradientLength": 120 }
        },
        "tooltip": [
          { "field": "state", "title": "State" },
          { "field": "genre", "title": "Genre" },
          { "field": "pct", "title": "Share of State Festivals (%)", "format": ".0f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "font": "DM Sans, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "state", "type": "nominal",
          "sort": ["NSW","QLD","SA","TAS","VIC","WA"]
        },
        "y": {
          "field": "genre", "type": "nominal",
          "sort": ["Electronic","Rock","Country","Indie","Other"]
        },
        "text": { "field": "pct", "type": "quantitative", "format": ".0f" },
        "color": {
          "condition": { "test": "datum.pct >= 28 || datum.pct <= 12", "value": "#ffffff" },
          "value": "#1a1a14"
        }
      }
    }
  ]
}
