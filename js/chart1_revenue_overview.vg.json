{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11, "gridOpacity": 0.6
    }
  },
  "vconcat": [
    {
      "width": "container",
      "height": 280,
      "data": { "url": "data/lpa_annual.json" },
      "layer": [
        {
          "mark": { "type": "area", "interpolate": "monotone",
            "line": { "color": "#FFD166", "strokeWidth": 2.5 },
            "color": { "gradient": "linear", "x1": 0, "y1": 0, "x2": 0, "y2": 1,
              "stops": [{"offset": 0, "color": "#FFD166", "opacity": 0.22}, {"offset": 1, "color": "#FFD166", "opacity": 0}] } },
          "encoding": {
            "x": { "field": "year", "type": "quantitative", "scale": { "domain": { "param": "brush" } },
              "axis": { "format": "d", "title": null, "tickCount": 6, "labelFontSize": 12 } },
            "y": { "field": "revenue_b", "type": "quantitative",
              "axis": { "title": "Revenue (AUD Billion)", "format": "$,.1f", "titleFontSize": 11 } }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 60, "color": "#FFD166" },
          "encoding": {
            "x": { "field": "year", "type": "quantitative", "scale": { "domain": { "param": "brush" } } },
            "y": { "field": "revenue_b", "type": "quantitative" },
            "tooltip": [
              {"field": "year", "title": "Year", "format": "d"},
              {"field": "revenue_b", "title": "Total Revenue (AUD Billion)", "format": "$.2f"},
              {"field": "attendance_m", "title": "Total Attendance (millions)", "format": ".1f"},
              {"field": "avg_ticket", "title": "Average Ticket Price (AUD)", "format": "$d"}
            ]
          }
        },
        {
          "data": {"values": [{"year": 2020, "revenue_b": 0.52}]},
          "layer": [
            {"mark": {"type": "rule", "color": "#EF233C", "strokeWidth": 1, "strokeDash": [4,4]},
             "encoding": {"x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush"}}}}},
            {"mark": {"type": "text", "align": "left", "dx": 6, "dy": -80, "color": "#EF233C",
               "font": "Space Mono, monospace", "fontSize": 10, "fontWeight": "bold"},
             "encoding": {
               "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush"}}},
               "y": {"field": "revenue_b", "type": "quantitative"},
               "text": {"value": "COVID −77%"}}}
          ]
        },
        {
          "data": {"values": [{"year": 2024, "revenue_b": 3.41}]},
          "mark": {"type": "text", "align": "right", "dx": -6, "dy": -14,
            "color": "#06D6A0", "font": "Space Mono, monospace", "fontSize": 10, "fontWeight": "bold"},
          "encoding": {
            "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush"}}},
            "y": {"field": "revenue_b", "type": "quantitative"},
            "text": {"value": "Record $3.41B ▲"}
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 56,
      "data": { "url": "data/lpa_annual.json" },
      "params": [{"name": "brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "area", "interpolate": "monotone", "color": "#FFD166", "opacity": 0.35},
      "encoding": {
        "x": {"field": "year", "type": "quantitative",
          "axis": {"format": "d", "title": "← Drag here to filter the detail chart above →",
            "labelFontSize": 10, "titleFontSize": 10, "titleColor": "#555548"}},
        "y": {"field": "revenue_b", "type": "quantitative",
          "axis": {"tickCount": 2, "grid": false, "title": null, "labelFontSize": 10}}
      }
    }
  ]
}
