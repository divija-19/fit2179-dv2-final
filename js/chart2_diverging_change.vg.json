{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 11, "titleFontSize": 11, "gridOpacity": 0.5
    }
  },
  "data": { "url": "data/lpa_annual.json" },
  "transform": [{ "filter": "datum.year > 2004" }],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 2, "cornerRadiusTopLeft": 2,
        "cornerRadiusBottomRight": 2, "cornerRadiusBottomLeft": 2
      },
      "encoding": {
        "x": {
          "field": "year", "type": "ordinal",
          "axis": { "title": null, "labelAngle": -45, "labelFontSize": 11 }
        },
        "y": {
          "field": "rev_pct_change", "type": "quantitative",
          "axis": {
            "title": "Year-on-year Revenue Change (%)",
            "grid": true, "titleFontSize": 11
          },
          "scale": { "domain": [-100, 110] }
        },
        "color": {
          "condition": { "test": "datum.rev_pct_change < 0", "value": "#EF233C" },
          "value": "#06D6A0"
        },
        "tooltip": [
          { "field": "year", "title": "Year" },
          { "field": "rev_pct_change", "title": "Change from Prior Year (%)", "format": "+.1f" },
          { "field": "revenue_b", "title": "Total Revenue (AUD Billion)", "format": "$.2f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#484840", "strokeWidth": 1, "strokeDash": [4, 4] },
      "encoding": { "y": { "datum": 0, "type": "quantitative" } }
    },
    {
      "data": { "values": [{ "year": "2020", "v": -76.9 }] },
      "mark": {
        "type": "text", "align": "center",
        "dy": 18,
        "color": "#ffffff",
        "font": "Space Mono, monospace", "fontSize": 11, "fontWeight": "bold"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "v", "type": "quantitative" },
        "text": { "value": "−77%" }
      }
    },
    {
      "data": { "values": [{ "year": "2022", "v": 95.9 }] },
      "mark": {
        "type": "text", "align": "center", "dy": -12,
        "color": "#06D6A0",
        "font": "Space Mono, monospace", "fontSize": 11, "fontWeight": "bold"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "v", "type": "quantitative" },
        "text": { "value": "+96%" }
      }
    }
  ]
}
