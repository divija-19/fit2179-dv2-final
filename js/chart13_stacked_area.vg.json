{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 280,
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    },
    "legend": {
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11
    }
  },
  "data": {"url": "data/lpa_annual.json"},
  "transform": [
    {"fold": ["contemporary_revenue_b", "other_revenue_b"], "as": ["category_key", "value"]},
    {"calculate": "datum.category_key === 'contemporary_revenue_b' ? 'Contemporary Music' : 'All Other Categories'",
     "as": "category"}
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {"field": "year", "type": "quantitative",
      "axis": {"format": "d", "title": "Year", "tickCount": 11}},
    "y": {"field": "value", "type": "quantitative", "stack": "zero",
      "axis": {"title": "Revenue (AUD Billion)", "format": "$,.1f"}},
    "color": {
      "field": "category", "type": "nominal",
      "scale": {
        "domain": ["Contemporary Music", "All Other Categories"],
        "range": ["#FFD166", "#1e1e18"]
      },
      "legend": {"title": "Category", "orient": "top-right"}
    },
    "opacity": {
      "field": "category", "type": "nominal",
      "scale": {"domain": ["Contemporary Music", "All Other Categories"], "range": [0.9, 0.6]},
      "legend": null
    },
    "tooltip": [
      {"field": "year", "title": "Year", "format": "d"},
      {"field": "category", "title": "Category"},
      {"field": "value", "title": "Revenue (AUD Billion)", "format": "$.2f"}
    ]
  }
}
