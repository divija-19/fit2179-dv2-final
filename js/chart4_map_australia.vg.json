{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 530,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "legend": {
      "labelColor": "#c8c2b4", "titleColor": "#e0dcd4",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11,
      "padding": 8, "cornerRadius": 3,
      "fillColor": "rgba(10,10,8,0.7)", "strokeColor": "#2a2a22"
    }
  },
  "projection": { "type": "mercator", "center": [132, -27], "scale": 800 },
  "layer": [
    {
      "data": { "url": "js/ne_110m.json", "format": { "type": "topojson", "feature": "countries" } },
      "mark": { "type": "geoshape", "fill": "#0d0d0c", "stroke": "#181816", "strokeWidth": 0.5 }
    },
    {
      "data": { "url": "js/ne_110m.json", "format": { "type": "topojson", "feature": "countries" } },
      "transform": [{ "filter": "datum.id === 36" }],
      "mark": { "type": "geoshape", "fill": "#181816", "stroke": "#2a2a22", "strokeWidth": 1.5 }
    },
    {
      "data": { "url": "data/state_data.json" },
      "mark": { "type": "circle", "opacity": 0.78, "stroke": "#ffffff", "strokeWidth": 0.5, "strokeOpacity": 0.15 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "size": {
          "field": "revenue_b", "type": "quantitative",
          "scale": { "range": [600, 7800] },
          "legend": {
            "title": "Revenue (AUD Billion)",
            "labelFormat": "$.2f",
            "orient": "top-left",
            "labelFontSize": 12, "titleFontSize": 11,
            "symbolOpacity": 0.7,
            "symbolFillColor": "#888",
            "fillColor": "rgba(10,10,8,0.75)", "strokeColor": "#2a2a22",
            "padding": 8
          }
        },
        "color": {
          "field": "revenue_b", "type": "quantitative",
          "scale": { "scheme": "goldorange", "domain": [0, 1.2] },
          "legend": null
        },
        "tooltip": [
          { "field": "state", "title": "State" },
          { "field": "revenue_b", "title": "Revenue (AUD Billion)", "format": "$.3f" },
          { "field": "revenue_share", "title": "Revenue Share (%)", "format": ".1f" },
          { "field": "attendance_m", "title": "Attendance (millions)", "format": ".2f" },
          { "field": "festivals", "title": "Number of Festivals" },
          { "field": "revenue_vs_pop", "title": "Revenue vs Population Share (pp)", "format": "+.1f" }
        ]
      }
    },
    {
      "data": { "url": "data/festival_locations.json" },
      "mark": {
        "type": "point", "shape": "diamond", "filled": true,
        "size": 55, "opacity": 0.85, "strokeWidth": 0
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "color": {
          "field": "genre", "type": "nominal",
          "scale": {
            "domain": ["Electronic","Rock","Country","Indie","Multi-genre","Folk","World","Blues","Blues/Roots"],
            "range": ["#06D6A0","#FF6B6B","#FFD166","#A8E6CF","#9B5DE5","#F4A261","#C7B8EA","#4895EF","#73D2DE"]
          },
          "legend": {
            "title": "Festival Genre",
            "orient": "bottom-right",
            "labelFontSize": 12, "titleFontSize": 11,
            "symbolSize": 80, "symbolType": "diamond",
            "fillColor": "rgba(10,10,8,0.75)", "strokeColor": "#2a2a22",
            "padding": 8
          }
        },
        "tooltip": [
          { "field": "name", "title": "Festival" },
          { "field": "genre", "title": "Genre" },
          { "field": "state", "title": "State" },
          { "field": "capacity", "title": "Capacity", "format": ",d" }
        ]
      }
    },
    {
      "data": { "url": "data/state_data.json" },
      "mark": {
        "type": "text",
        "font": "Space Mono, monospace",
        "fontSize": 11, "fontWeight": "bold",
        "color": "#ffffff", "opacity": 1,
        "stroke": "#0a0a08", "strokeWidth": 2.5, "strokeOpacity": 0.6
      },
      "encoding": {
        "longitude": { "field": "label_lon", "type": "quantitative" },
        "latitude": { "field": "label_lat", "type": "quantitative" },
        "text": { "field": "state_abbr", "type": "nominal" },
        "size": {
          "field": "revenue_b", "type": "quantitative",
          "scale": { "range": [11, 14] },
          "legend": null
        }
      }
    }
  ]
}
