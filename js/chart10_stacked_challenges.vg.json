{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 340,
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    },
    "legend": {
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11
    }
  },
  "data": {"url": "data/challenges_stacked.json"},
  "params": [{
    "name": "min_sev",
    "value": 0,
    "bind": {"input": "range", "min": 0, "max": 45, "step": 5,
      "name": "Highlight challenges where Severe Impact ≥ "}
  }],
  "mark": {"type": "bar", "cornerRadiusTopRight": 3, "cornerRadiusBottomRight": 3},
  "encoding": {
    "y": {
      "field": "challenge", "type": "nominal",
      "sort": {"field": "severe_pct", "order": "descending"},
      "axis": {"title": null, "labelFontSize": 12, "labelLimit": 260, "labelColor": "#c0bab0"}
    },
    "x": {
      "field": "pct", "type": "quantitative",
      "axis": {"title": "Percentage of Festival Organisers Reporting this Challenge (%)", "titleFontSize": 11},
      "scale": {"domain": [0, 90]}
    },
    "color": {
      "field": "impact_type", "type": "nominal",
      "scale": {
        "domain": ["Severe impact", "Major impact"],
        "range": ["#EF233C", "#5a1e28"]
      },
      "legend": {"title": "Impact Level", "orient": "bottom-right"}
    },
    "opacity": {
      "condition": {"test": "datum.severe_pct >= min_sev", "value": 1},
      "value": 0.1
    },
    "order": {"field": "impact_type", "sort": "descending"},
    "tooltip": [
      {"field": "challenge", "title": "Challenge"},
      {"field": "impact_type", "title": "Impact Level"},
      {"field": "pct", "title": "Organisers Affected (%)", "format": ".0f"},
      {"field": "severe_pct", "title": "Severe Impact (%)", "format": ".0f"}
    ]
  }
}
