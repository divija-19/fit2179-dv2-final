{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 400,
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    },
    "legend": {
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    }
  },
  "data": {"url": "data/state_data.json"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "opacity": 0.88},
      "encoding": {
        "x": {"field": "attendance_m", "type": "quantitative",
          "axis": {"title": "Total Attendance (millions)", "format": ".1f", "titleFontSize": 11},
          "scale": {"domain": [-0.5, 12]}},
        "y": {"field": "revenue_b", "type": "quantitative",
          "axis": {"title": "Total Revenue (AUD Billion)", "format": "$,.2f", "titleFontSize": 11},
          "scale": {"domain": [-0.05, 1.35]}},
        "size": {
          "field": "festivals", "type": "quantitative",
          "scale": {"range": [100, 2400]},
          "legend": {"title": "Number of Festivals", "orient": "bottom-right",
            "labelFontSize": 12, "values": [10, 50, 100, 149]}
        },
        "color": {
          "field": "revenue_vs_pop", "type": "quantitative",
          "scale": {"scheme": "redyellowgreen", "domain": [-5, 5]},
          "legend": {"title": "Revenue vs Population Share (pp)",
            "orient": "top-left", "gradientLength": 100}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "revenue_b", "title": "Total Revenue (AUD Billion)", "format": "$.3f"},
          {"field": "attendance_m", "title": "Total Attendance (millions)", "format": ".2f"},
          {"field": "festivals", "title": "Number of Festivals"},
          {"field": "revenue_vs_pop", "title": "Revenue vs Population Share (pp)", "format": "+.1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "dy": -16, "fontSize": 12,
        "font": "Space Mono, monospace", "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "attendance_m", "type": "quantitative"},
        "y": {"field": "revenue_b", "type": "quantitative"},
        "text": {"field": "state_abbr", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.revenue_vs_pop >= 0", "value": "#06D6A0"},
          "value": "#EF233C"
        }
      }
    }
  ]
}
