{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11, "gridOpacity": 0.4
    },
    "legend": {
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    }
  },
  "data": { "url": "data/genres.json" },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2 },
      "encoding": {
        "y": {
          "field": "genre", "type": "nominal",
          "sort": { "field": "pct", "order": "descending" },
          "axis": { "title": null, "labelFontSize": 14, "labelColor": "#d0cac0" }
        },
        "x": { "datum": 0, "type": "quantitative" },
        "x2": { "field": "pct", "type": "quantitative" },
        "color": { "value": "#2e2e28" }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "opacity": 0.92 },
      "encoding": {
        "y": {
          "field": "genre", "type": "nominal",
          "sort": { "field": "pct", "order": "descending" }
        },
        "x": {
          "field": "pct", "type": "quantitative",
          "axis": { "title": "Share of all 535 festivals (%)", "titleFontSize": 11 },
          "scale": { "domain": [0, 30] }
        },
        "size": {
          "field": "festivals", "type": "quantitative",
          "scale": { "range": [120, 900] },
          "legend": {
            "title": "Number of Festivals",
            "orient": "bottom-right",
            "values": [20, 50, 80, 110]
          }
        },
        "color": {
          "field": "genre", "type": "nominal",
          "scale": {
            "domain": ["Electronic","Rock","Country","Indie","Multi-genre","Classical","Other"],
            "range": ["#FF6B6B","#FFE66D","#06D6A0","#A8E6CF","#9B5DE5","#C7B8EA","#555555"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "genre", "title": "Genre" },
          { "field": "pct", "title": "Share of All Festivals (%)", "format": ".0f" },
          { "field": "festivals", "title": "Number of Festivals" }
        ]
      }
    },
    {
      "mark": {
        "type": "text", "align": "left", "dx": 12,
        "font": "Space Mono, monospace", "fontSize": 12, "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "genre", "type": "nominal",
          "sort": { "field": "pct", "order": "descending" }
        },
        "x": { "field": "pct", "type": "quantitative" },
        "text": {
          "calculate": "datum.pct + '% · ' + datum.festivals + ' festivals'",
          "type": "nominal"
        },
        "color": { "value": "#c8c2b4" }
      }
    }
  ]
}
