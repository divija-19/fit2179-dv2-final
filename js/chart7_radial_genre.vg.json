{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 340,
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "legend": {
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11
    }
  },
  "data": {"url": "data/genres.json"},
  "mark": {"type": "arc", "innerRadius": 58, "padAngle": 0.04, "cornerRadius": 4},
  "encoding": {
    "theta": {"field": "pct", "type": "quantitative", "stack": true},
    "radius": {"field": "pct", "type": "quantitative",
      "scale": {"range": [58, 190]}},
    "color": {
      "field": "genre", "type": "nominal",
      "scale": {
        "domain": ["Electronic","Rock","Country","Indie","Multi-genre","Classical","Other"],
        "range": ["#FF6B6B","#FFE66D","#06D6A0","#A8E6CF","#9B5DE5","#C7B8EA","#555555"]
      },
      "legend": {"orient": "right", "title": "Genre", "labelFontSize": 13}
    },
    "tooltip": [
      {"field": "genre", "title": "Genre"},
      {"field": "pct", "title": "Share of All Festivals (%)", "format": ".0f"},
      {"field": "festivals", "title": "Number of Festivals"}
    ]
  }
}
