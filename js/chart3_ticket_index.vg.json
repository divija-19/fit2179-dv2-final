{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "padding": 10,
  "config": {
    "background": "transparent",
    "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24",
      "gridColor": "#1c1c16",
      "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4",
      "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif",
      "titleFont": "Space Mono, monospace",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "gridOpacity": 0.5
    }
  },
  "data": {"url": "data/lpa_annual.json"},
  "resolve": {
    "scale": {"y": "independent"},
    "axis": {"y": "independent"}
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": -60,
            "labelFontSize": 9,
            "labelOverlap": true
          }
        },
        "y": {
          "field": "avg_ticket",
          "type": "quantitative",
          "axis": {
            "title": "Average Ticket Price (AUD)",
            "orient": "left",
            "format": "$d",
            "titleColor": "#c8c2b4",
            "titleFontSize": 10,
            "labelFontSize": 10,
            "titlePadding": 8,
            "labelPadding": 4,
            "offset": 8
          },
          "scale": {"domain": [0, 175]}
        },
        "color": {
          "condition": {"test": "datum.avg_ticket >= 90", "value": "#F4A261"},
          "value": "#2e2e28"
        },
        "tooltip": [
          {"field": "year", "title": "Year"},
          {
            "field": "avg_ticket",
            "title": "Average Ticket Price (AUD)",
            "format": "$d"
          },
          {
            "field": "revenue_index",
            "title": "Revenue Index (2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#555548",
        "strokeWidth": 1.2,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "y": {
          "datum": 100,
          "type": "quantitative",
          "scale": {"domain": [0, 175]}
        }
      }
    },
    {
      "data": {"values": [{"year": "2004", "lbl": "2019 baseline = 100"}]},
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -8,
        "color": "#888",
        "font": "Space Mono, monospace",
        "fontSize": 9,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {
          "datum": 100,
          "type": "quantitative",
          "scale": {"domain": [0, 175]}
        },
        "text": {"field": "lbl"}
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#FFD166",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "revenue_index",
          "type": "quantitative",
          "axis": {
            "title": "Revenue Index (2019 = 100)",
            "orient": "right",
            "titleColor": "#FFD166",
            "labelColor": "#b09940",
            "titleFontSize": 10,
            "labelFontSize": 10,
            "titlePadding": 8,
            "labelPadding": 6,
            "offset": 8
          },
          "scale": {"domain": [0, 175]}
        }
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 50, "color": "#FFD166"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {
          "field": "revenue_index",
          "type": "quantitative",
          "scale": {"domain": [0, 175]}
        },
        "tooltip": [
          {"field": "year", "title": "Year"},
          {
            "field": "revenue_index",
            "title": "Revenue Index (2019 = 100)",
            "format": ".1f"
          },
          {
            "field": "avg_ticket",
            "title": "Average Ticket Price (AUD)",
            "format": "$d"
          }
        ]
      }
    },
    {
      "data": {"values": [{"year": "2024", "revenue_index": 151.6}]},
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": -13,
        "color": "#FFD166",
        "font": "Space Mono, monospace",
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {
          "field": "revenue_index",
          "type": "quantitative",
          "scale": {"domain": [0, 175]}
        },
        "text": {"value": "Index 152 ▲"}
      }
    }
  ]
}
