{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 300,
  "padding": 10,

  "config": {
    "background": "transparent",

    "view": {
      "stroke": "transparent"
    },

    "axis": {
      "domainColor": "#2a2a24",
      "gridColor": "#1c1c16",
      "tickColor": "#2a2a24",

      "labelColor": "#c8c2b4",
      "titleColor": "#d0cac0",

      "labelFont": "DM Sans, sans-serif",
      "titleFont": "Space Mono, monospace",

      "labelFontSize": 10,
      "titleFontSize": 10,

      "gridOpacity": 0.5
    }
  },

  "data": {
    "url": "data/lpa_annual.json"
  },

  "resolve": {
    "scale": {
      "y": "independent"
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",

          "axis": {
            "title": null,
            "labelAngle": -45,
            "labelFontSize": 9,
            "labelOverlap": "greedy"
          }
        },

        "y": {
          "field": "avg_ticket",
          "type": "quantitative",

          "scale": {
            "domain": [0, 130]
          },

          "axis": {
            "title": "Average Ticket Price (AUD)",
            "orient": "left",

            "format": "$d",

            "tickCount": 7,

            "titleColor": "#c8c2b4",
            "labelColor": "#c8c2b4",

            "titlePadding": 8,
            "labelPadding": 4
          }
        },

        "color": {
          "condition": {
            "test": "datum.avg_ticket >= 90",
            "value": "#F4A261"
          },
          "value": "#2e2e28"
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "avg_ticket",
            "title": "Average Ticket Price (AUD)",
            "format": "$.0f"
          },
          {
            "field": "revenue_index",
            "title": "Revenue Index (2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "rule",
        "color": "#555548",
        "strokeWidth": 1.2,
        "strokeDash": [4, 4]
      },

      "encoding": {
        "y": {
          "datum": 77
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "year": "2004",
            "label": "2019 baseline = 100"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -14,
        "font": "Space Mono, monospace",
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#888888"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "datum": 77
        },

        "text": {
          "field": "label"
        }
      }
    },

    {
      "mark": {
        "type": "line",
        "color": "#FFD166",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative",

          "scale": {
            "domain": [0, 160]
          },

          "axis": {
            "title": "Revenue Index (2019 = 100)",

            "orient": "right",

            "tickCount": 8,

            "offset": 15,
            "titlePadding": 20,
            "labelPadding": 8,

            "titleColor": "#FFD166",
            "labelColor": "#b09940",

            "titleFontSize": 10,
            "labelFontSize": 10
          }
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "color": "#FFD166"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "revenue_index",
            "title": "Revenue Index (2019 = 100)",
            "format": ".1f"
          },
          {
            "field": "avg_ticket",
            "title": "Average Ticket Price (AUD)",
            "format": "$.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2024'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": -18,

        "font": "Space Mono, monospace",
        "fontWeight": "bold",
        "fontSize": 10,

        "color": "#FFD166"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative"
        },

        "text": {
          "expr": "'Index ' + format(datum.revenue_index,'.0f') + ' ▲'"
        }
      }
    }
  ]
}
