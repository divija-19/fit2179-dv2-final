{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 11, "titleFontSize": 11, "gridOpacity": 0.5
    }
  },
  "data": { "url": "data/lpa_annual.json" },
  "resolve": { "scale": { "y": "independent" } },
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2 },
      "encoding": {
        "x": {
          "field": "year", "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": -55,
            "labelFontSize": 10,
            "labelOverlap": "parity"
          }
        },
        "y": {
          "field": "avg_ticket", "type": "quantitative",
          "axis": {
            "title": "Avg Ticket Price (AUD)",
            "format": "$d",
            "titleColor": "#c8c2b4",
            "titleFontSize": 10,
            "labelFontSize": 10
          },
          "scale": { "domain": [40, 140] }
        },
        "color": {
          "condition": { "test": "datum.avg_ticket >= 90", "value": "#F4A261" },
          "value": "#2a2a22"
        },
        "tooltip": [
          { "field": "year", "title": "Year" },
          { "field": "avg_ticket", "title": "Average Ticket Price (AUD)", "format": "$d" },
          { "field": "revenue_index", "title": "Revenue Index (2019 = 100)", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#484840", "strokeWidth": 1, "strokeDash": [4, 4] },
      "encoding": {
        "y": { "datum": 100, "type": "quantitative", "scale": { "domain": [0, 185] } }
      }
    },
    {
      "data": { "values": [{ "year": "2019" }] },
      "mark": {
        "type": "text", "align": "center", "dy": -8, "dx": 0,
        "color": "#666", "font": "Space Mono, monospace", "fontSize": 9, "fontStyle": "italic",
        "baseline": "bottom"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "datum": 100, "type": "quantitative", "scale": { "domain": [0, 185] } },
        "text": { "value": "2019 = 100" }
      }
    },
    {
      "mark": { "type": "line", "color": "#FFD166", "strokeWidth": 2.5, "interpolate": "monotone" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "revenue_index", "type": "quantitative",
          "axis": {
            "title": "Revenue Index (2019 = 100)",
            "titleColor": "#FFD166",
            "titleFontSize": 10,
            "labelFontSize": 10,
            "labelColor": "#FFD166"
          },
          "scale": { "domain": [0, 185] }
        }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 55, "color": "#FFD166" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "revenue_index", "type": "quantitative",
          "scale": { "domain": [0, 185] }
        },
        "tooltip": [
          { "field": "year", "title": "Year" },
          { "field": "revenue_index", "title": "Revenue Index (2019 = 100)", "format": ".1f" },
          { "field": "avg_ticket", "title": "Average Ticket Price (AUD)", "format": "$d" }
        ]
      }
    },
    {
      "data": { "values": [{ "year": "2024", "revenue_index": 151.6 }] },
      "mark": {
        "type": "text", "align": "right", "dx": -4, "dy": -13,
        "color": "#FFD166", "font": "Space Mono, monospace", "fontSize": 10, "fontWeight": "bold"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": {
          "field": "revenue_index", "type": "quantitative",
          "scale": { "domain": [0, 185] }
        },
        "text": { "value": "Index 152 ▲" }
      }
    }
  ]
}
