{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container", "height": 260,
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 11, "titleFontSize": 11
    }
  },
  "data": {"url": "data/lpa_annual.json"},
  "resolve": {"scale": {"y": "independent"}},
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2},
      "encoding": {
        "x": {"field": "year", "type": "ordinal",
          "axis": {"title": null, "labelAngle": -45, "labelFontSize": 11}},
        "y": {"field": "avg_ticket", "type": "quantitative",
          "axis": {"title": "Average Ticket Price (AUD)", "format": "$d",
            "titleColor": "#b0aa9e", "titleFontSize": 11},
          "scale": {"domain": [40, 135]}},
        "color": {
          "condition": {"test": "datum.avg_ticket >= 90", "value": "#F4A261"},
          "value": "#282824"
        },
        "tooltip": [
          {"field": "year", "title": "Year"},
          {"field": "avg_ticket", "title": "Average Ticket Price (AUD)", "format": "$d"},
          {"field": "revenue_index", "title": "Revenue Index (2019 = 100)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#48483e", "strokeWidth": 1, "strokeDash": [3,3]},
      "encoding": {"y": {"datum": 100, "type": "quantitative", "scale": {"domain": [0, 180]}}}
    },
    {
      "data": {"values": [{"year": "2019", "lbl": "2019 = 100"}]},
      "mark": {"type": "text", "align": "center", "dy": -172, "color": "#666",
        "font": "Space Mono, monospace", "fontSize": 9, "fontStyle": "italic"},
      "encoding": {"x": {"field": "year", "type": "ordinal"}, "text": {"field": "lbl"}}
    },
    {
      "mark": {"type": "line", "color": "#FFD166", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "revenue_index", "type": "quantitative",
          "axis": {"title": "Revenue Index (2019 = 100)", "titleColor": "#FFD166", "titleFontSize": 11, "labelFontSize": 10},
          "scale": {"domain": [0, 180]}}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 50, "color": "#FFD166"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "revenue_index", "type": "quantitative", "scale": {"domain": [0, 180]}},
        "tooltip": [
          {"field": "year", "title": "Year"},
          {"field": "revenue_index", "title": "Revenue Index (2019 = 100)", "format": ".1f"},
          {"field": "avg_ticket", "title": "Average Ticket Price (AUD)", "format": "$d"}
        ]
      }
    },
    {
      "data": {"values": [{"year": "2024", "revenue_index": 151.6}]},
      "mark": {"type": "text", "align": "right", "dx": -4, "dy": -13,
        "color": "#FFD166", "font": "Space Mono, monospace", "fontSize": 9, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "revenue_index", "type": "quantitative", "scale": {"domain": [0, 180]}},
        "text": {"value": "Index 152 ▲"}
      }
    }
  ]
}
