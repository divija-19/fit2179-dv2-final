
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "padding": 10,

  "config": {
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#2a2a24",
      "gridColor": "#1c1c16",
      "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4",
      "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif",
      "titleFont": "Space Mono, monospace",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "gridOpacity": 0.5
    }
  },

  "data": {
    "url": "data/lpa_annual.json"
  },

  "resolve": {
    "scale": {
      "y": "independent"
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": null,
            "labelAngle": -60,
            "labelFontSize": 9
          }
        },

        "y": {
          "field": "avg_ticket",
          "type": "quantitative",
          "scale": {
            "domain": [0, 175]
          },
          "axis": {
            "title": "Average Ticket Price (AUD)",
            "orient": "left",
            "format": "$d",
            "values": [0, 20, 40, 60, 80, 100, 120, 140, 160],
            "titleColor": "#c8c2b4",
            "labelColor": "#c8c2b4"
          }
        },

        "color": {
          "condition": {
            "test": "datum.avg_ticket >= 90",
            "value": "#F4A261"
          },
          "value": "#2e2e28"
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "avg_ticket",
            "title": "Average Ticket Price (AUD)",
            "format": "$.0f"
          },
          {
            "field": "revenue_index",
            "title": "Revenue Index (2019 = 100)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "rule",
        "color": "#555548",
        "strokeDash": [4, 4],
        "strokeWidth": 1.2
      },

      "encoding": {
        "y": {
          "datum": 100
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "year": "2019",
            "label": "2019 baseline = 100"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -8,
        "font": "Space Mono, monospace",
        "fontSize": 9,
        "fontStyle": "italic",
        "color": "#888888"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "datum": 100
        },

        "text": {
          "field": "label"
        }
      }
    },

    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": "#FFD166",
        "interpolate": "monotone"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative",

          "scale": {
            "domain": [0, 175]
          },

          "axis": {
            "title": "Revenue Index (2019 = 100)",
            "orient": "right",
            "values": [0, 20, 40, 60, 80, 100, 120, 140, 160],
            "titleColor": "#FFD166",
            "labelColor": "#FFD166"
          }
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "color": "#FFD166"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "revenue_index",
            "title": "Revenue Index",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == '2024'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -12,
        "font": "Space Mono, monospace",
        "fontWeight": "bold",
        "fontSize": 10,
        "color": "#FFD166"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },

        "y": {
          "field": "revenue_index",
          "type": "quantitative"
        },

        "text": {
          "expr": "'Index ' + round(datum.revenue_index) + ' ▲'"
        }
      }
    }
  ]
}

