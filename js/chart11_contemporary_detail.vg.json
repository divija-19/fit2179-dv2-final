{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "background": "transparent", "view": {"stroke": "transparent"},
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#b0aa9e", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 12, "titleFontSize": 11
    }
  },
  "vconcat": [
    {
      "width": "container", "height": 260,
      "data": {"url": "data/lpa_annual.json"},
      "layer": [
        {
          "mark": {"type": "area", "interpolate": "monotone",
            "line": {"color": "#F4A261", "strokeWidth": 2.5},
            "color": {"gradient": "linear", "x1": 0, "y1": 0, "x2": 0, "y2": 1,
              "stops": [{"offset": 0, "color": "#F4A261", "opacity": 0.28}, {"offset": 1, "color": "#F4A261", "opacity": 0.02}]}},
          "encoding": {
            "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush2"}},
              "axis": {"format": "d", "title": null, "tickCount": 6}},
            "y": {"field": "contemporary_share_pct", "type": "quantitative",
              "axis": {"title": "Contemporary Music Share of Total Revenue (%)", "titleFontSize": 11},
              "scale": {"domain": [28, 62]}},
            "tooltip": [
              {"field": "year", "title": "Year", "format": "d"},
              {"field": "contemporary_share_pct", "title": "Contemporary Music Share (%)", "format": ".1f"},
              {"field": "contemporary_revenue_b", "title": "Contemporary Revenue (AUD Billion)", "format": "$.2f"},
              {"field": "revenue_b", "title": "Total Revenue (AUD Billion)", "format": "$.2f"}
            ]
          }
        },
        {"mark": {"type": "point", "filled": true, "size": 55, "color": "#F4A261"},
         "encoding": {
           "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush2"}}},
           "y": {"field": "contemporary_share_pct", "type": "quantitative"}
         }},
        {"mark": {"type": "rule", "color": "#484840", "strokeWidth": 1, "strokeDash": [4,4]},
         "encoding": {"y": {"datum": 43, "type": "quantitative"}}},
        {
          "data": {"values": [{"year": 2017, "v": 43}]},
          "mark": {"type": "text", "align": "left", "dx": 6, "dy": -12, "color": "#666",
            "font": "Space Mono, monospace", "fontSize": 9, "fontStyle": "italic"},
          "encoding": {
            "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush2"}}},
            "y": {"field": "v", "type": "quantitative"},
            "text": {"value": "2017 baseline: 43%"}
          }
        },
        {
          "data": {"values": [{"year": 2024, "v": 54}]},
          "mark": {"type": "text", "align": "right", "dx": -5, "dy": -14, "color": "#F4A261",
            "font": "Space Mono, monospace", "fontSize": 10, "fontWeight": "bold"},
          "encoding": {
            "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush2"}}},
            "y": {"field": "v", "type": "quantitative"},
            "text": {"value": "2024: 54% ▲"}
          }
        },
        {
          "data": {"values": [{"year": 2020, "v": 38.5}]},
          "mark": {"type": "text", "align": "left", "dx": 6, "dy": 0, "color": "#EF233C",
            "font": "Space Mono, monospace", "fontSize": 9, "fontStyle": "italic"},
          "encoding": {
            "x": {"field": "year", "type": "quantitative", "scale": {"domain": {"param": "brush2"}}},
            "y": {"field": "v", "type": "quantitative"},
            "text": {"value": "COVID dip"}
          }
        }
      ]
    },
    {
      "width": "container", "height": 56,
      "data": {"url": "data/lpa_annual.json"},
      "params": [{"name": "brush2", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "area", "interpolate": "monotone", "color": "#F4A261", "opacity": 0.32},
      "encoding": {
        "x": {"field": "year", "type": "quantitative",
          "axis": {"format": "d", "title": "← Drag to zoom the chart above →",
            "labelFontSize": 10, "titleFontSize": 10, "titleColor": "#555548"}},
        "y": {"field": "contemporary_share_pct", "type": "quantitative",
          "axis": {"tickCount": 2, "grid": false, "title": null}}
      }
    }
  ]
}
