{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 310,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 14, "titleFontSize": 11, "gridOpacity": 0.5
    }
  },
  "data": { "url": "data/state_data.json" },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 3, "cornerRadiusBottomRight": 3,
        "cornerRadiusTopLeft": 3, "cornerRadiusBottomLeft": 3
      },
      "encoding": {
        "y": {
          "field": "state_abbr", "type": "nominal",
          "sort": { "field": "revenue_vs_pop", "order": "descending" },
          "axis": { "title": null, "labelFontSize": 14, "labelColor": "#d0cac0" }
        },
        "x": {
          "field": "revenue_vs_pop", "type": "quantitative",
          "axis": {
            "title": "Revenue Share minus Population Share (percentage points)",
            "grid": true, "titleFontSize": 11
          },
          "scale": { "domain": [-8, 8] }
        },
        "color": {
          "condition": { "test": "datum.revenue_vs_pop >= 0", "value": "#06D6A0" },
          "value": "#EF233C"
        },
        "tooltip": [
          { "field": "state", "title": "State" },
          { "field": "revenue_share", "title": "Revenue Share (%)", "format": ".1f" },
          { "field": "pop_share", "title": "Population Share (%)", "format": ".1f" },
          { "field": "revenue_vs_pop", "title": "Difference (percentage points)", "format": "+.1f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#484840", "strokeWidth": 1, "strokeDash": [3, 3] },
      "encoding": { "x": { "datum": 0, "type": "quantitative" } }
    },
    {
      "mark": {
        "type": "text", "align": "left", "dx": 7,
        "font": "Space Mono, monospace", "fontSize": 12, "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "state_abbr", "type": "nominal",
          "sort": { "field": "revenue_vs_pop", "order": "descending" }
        },
        "x": { "field": "revenue_vs_pop", "type": "quantitative" },
        "text": { "field": "revenue_vs_pop", "type": "quantitative", "format": "+.1f" },
        "color": {
          "condition": { "test": "datum.revenue_vs_pop >= 0", "value": "#06D6A0" },
          "value": "#EF233C"
        }
      }
    }
  ]
}
