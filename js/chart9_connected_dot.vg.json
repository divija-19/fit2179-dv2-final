{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "axis": {
      "domainColor": "#2a2a24", "gridColor": "#1c1c16", "tickColor": "#2a2a24",
      "labelColor": "#c8c2b4", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 14, "titleFontSize": 11, "gridOpacity": 0.5
    },
    "legend": {
      "labelColor": "#d0cac0", "titleColor": "#d0cac0",
      "labelFont": "DM Sans, sans-serif", "titleFont": "Space Mono, monospace",
      "labelFontSize": 13, "titleFontSize": 11
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {"age_group": "18–24",  "pre": 32, "post": 20},
          {"age_group": "25–34",  "pre": 28, "post": 35},
          {"age_group": "35–44",  "pre": 20, "post": 24},
          {"age_group": "45–54",  "pre": 13, "post": 14},
          {"age_group": "55+",    "pre": 7,  "post": 7}
        ]
      },
      "mark": { "type": "rule", "color": "#3a3a30", "strokeWidth": 3 },
      "encoding": {
        "x": {
          "field": "age_group", "type": "nominal",
          "sort": ["18–24","25–34","35–44","45–54","55+"],
          "axis": { "title": "Age Group", "labelFontSize": 14 }
        },
        "y": {
          "field": "pre", "type": "quantitative",
          "scale": { "domain": [0, 42] },
          "axis": { "title": "Share of All Ticket Buyers (%)", "titleFontSize": 11 }
        },
        "y2": { "field": "post" }
      }
    },
    {
      "data": { "url": "data/age_demographics.json" },
      "params": [{
        "name": "period_hl",
        "select": { "type": "point", "fields": ["period"] },
        "bind": "legend"
      }],
      "mark": { "type": "point", "filled": true, "size": 200 },
      "encoding": {
        "x": {
          "field": "age_group", "type": "nominal",
          "sort": ["18–24","25–34","35–44","45–54","55+"]
        },
        "y": {
          "field": "pct", "type": "quantitative",
          "scale": { "domain": [0, 42] }
        },
        "color": {
          "field": "period", "type": "nominal",
          "scale": {
            "domain": ["Pre-COVID (2018–19)", "Post-COVID (2022–23)"],
            "range": ["#9B5DE5", "#FFD166"]
          },
          "legend": { "title": "Period — click to highlight", "orient": "top-right" }
        },
        "opacity": {
          "condition": { "param": "period_hl", "value": 1 },
          "value": 0.1
        },
        "tooltip": [
          { "field": "age_group", "title": "Age Group" },
          { "field": "period", "title": "Period" },
          { "field": "pct", "title": "Share of Ticket Buyers (%)", "format": ".0f" }
        ]
      }
    },
    {
      "data": { "values": [
        {"age_group": "18–24", "pct": 34, "lbl": "−12pp", "clr": "#EF233C"},
        {"age_group": "25–34", "pct": 37, "lbl": "+7pp",  "clr": "#06D6A0"},
        {"age_group": "35–44", "pct": 26, "lbl": "+4pp",  "clr": "#06D6A0"}
      ]},
      "mark": {
        "type": "text", "align": "center", "dy": -14,
        "font": "Space Mono, monospace", "fontSize": 12, "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "age_group", "type": "nominal",
          "sort": ["18–24","25–34","35–44","45–54","55+"]
        },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "lbl" },
        "color": { "field": "clr", "type": "nominal", "scale": null }
      }
    }
  ]
}
